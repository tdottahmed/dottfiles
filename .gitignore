# tmux plugins are installed by TPM, only TPM itself is tracked
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/tpm

# composer installs these
composer/.config/composer/vendor

# ssh: only the sanitized config is tracked. Never private keys, never the
# client/production inventory that lives in ~/.ssh/config.d/.
ssh/.ssh/*
!ssh/.ssh/config
