# Packages installed by scripts/install-packages.sh
#
# One package name per line. Blank lines and #-comments are ignored.
# This file is the DISTRO-AGNOSTIC baseline on `main` -- it only lists packages
# whose name is identical on dnf and apt. Distro branches (fedora, ubuntu,
# debian) replace this file with the full list using that distro's names.

git
zsh
tmux
curl
wget
stow
unzip
kitty
vim
neovim
golang
