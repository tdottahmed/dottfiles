# Public-safe ssh config. Client/production hosts live in
# ~/.ssh/config.d/*.conf, which is deliberately NOT tracked here.
#
# ssh takes the FIRST value it finds for each keyword, so ordering matters:
#   Include first  -> host-specific settings win
#   Host *  last   -> defaults only apply where nothing more specific did

Include ~/.ssh/config.d/*.conf

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/default

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
